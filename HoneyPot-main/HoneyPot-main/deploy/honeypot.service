[Unit]
Description=Original educational SSH honeypot
After=network.target
Documentation=https://github.com/yourorg/ssh-honeypot

[Service]
Type=simple
User=honeypot
Group=honeypot
WorkingDirectory=/opt/ssh-honeypot
ExecStart=/opt/ssh-honeypot/venv/bin/python3 -m src.server --config config/config.yaml
Restart=on-failure
RestartSec=5

# Hardening — the honeypot needs no elevated privileges, no real network
# egress, and no write access outside its own logs/ directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ssh-honeypot/logs
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
